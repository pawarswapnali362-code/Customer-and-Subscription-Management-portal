# API settings
# Local SQLite file; the parent folder is created automatically.
DATABASE_PATH=./data/cliently.sqlite3
SESSION_SECRET=replace-this-with-a-long-random-secret
ADMIN_USER_ID=admin
ADMIN_PASSWORD=admin
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend setting (copy to frontend/.env.local if needed)
NEXT_PUBLIC_API_URL=http://localhost:8000
